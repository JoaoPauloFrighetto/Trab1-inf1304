{
  "name": "SmartFactory Lab - Kafka",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    // Docker-outside-of-Docker: em vez de rodar um daemon Docker "aninhado" dentro do
    // container do Codespace (docker-in-docker), essa feature conecta direto ao Docker que
    // já roda por trás da VM do Codespace (monta /var/run/docker.sock do host). Os containers
    // do projeto nascem como "irmãos" do devcontainer, na rede normal do host — evita o
    // isolamento de rede extra do docker-in-docker, que travou a comunicação entre os
    // containers do cluster Kafka (brokers nunca conseguiam se conectar entre si).
    // moby:false instala os pacotes oficiais docker-ce em vez do moby-cli do Ubuntu (o
    // mesmo motivo de antes: a versão de Ubuntu da imagem "base:ubuntu" pode ser nova
    // demais para ter o pacote moby-cli disponível).
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "version": "latest"
    }
  },
  // Só corrige o bit de execução dos scripts (o Git no Windows nem sempre preserva isso).
  // "|| true" garante que este comando nunca falha a criação do Codespace.
  "postCreateCommand": "chmod +x start.sh stop.sh scripts/*.sh || true",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
