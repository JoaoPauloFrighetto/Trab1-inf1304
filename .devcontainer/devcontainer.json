{
  "name": "SmartFactory Lab - Kafka",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    // Dá acesso a "docker" e "docker compose" dentro do Codespace (Docker-in-Docker),
    // sem depender do comportamento padrão da imagem do GitHub.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": true,
      "version": "latest"
    }
  },
  // Só corrige o bit de execução dos scripts (o Git no Windows nem sempre preserva isso).
  // "|| true" garante que este comando nunca falha a criação do Codespace, mesmo se o
  // Docker-in-Docker ainda não tiver terminado de subir nesse instante.
  "postCreateCommand": "chmod +x start.sh stop.sh scripts/*.sh || true",
  // 2 vCPU / 4 GB é o mínimo confortável para o cenário padrão (3 sensores + 3 consumidores).
  // Para o teste de elasticidade (até 8 consumidores + 9 sensores), escolha uma máquina maior
  // manualmente na hora de criar o Codespace, se sua conta/plano permitir.
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
