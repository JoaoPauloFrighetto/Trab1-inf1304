# Parâmetros do ambiente (lidos pelo docker-compose.yaml). Altere aqui, não no código.
KAFKA_IMAGE=apache/kafka:3.8.0
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_TOPIC=dados-sensores
KAFKA_PARTITIONS=6
KAFKA_REPLICATION_FACTOR=3
KAFKA_MIN_ISR=2
KAFKA_GROUP_ID=processadores-sensores
# Quantidade inicial de réplicas
SENSORES=3
CONSUMIDORES=3
# Sensores
INTERVALO_MS=500
PROB_ANOMALIA=0.10
# Limites de detecção de anomalias (consumidores)
TEMP_MAX=80
TEMP_CRITICA=100
VIBRACAO_MAX=7
ENERGIA_MAX=500
