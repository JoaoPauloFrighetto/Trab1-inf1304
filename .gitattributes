# Força fim de linha LF nos scripts e arquivos de configuração, independente do sistema
# operacional de quem clona/commita (evita o erro "\r: command not found" no Linux/Codespaces).
*.sh text eol=lf
*.env text eol=lf
.env text eol=lf
Makefile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
